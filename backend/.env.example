# ══════════════════════════════════════════════
#  Warehouse Pro — Backend ENV
# ══════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/warehouse?retryWrites=true&w=majority

# JWT — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SOSTITUISCI_CON_64_CARATTERI_CASUALI
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECURE=false        # true in produzione (HTTPS)

# CORS — URL frontend senza slash finale
FRONTEND_URL=http://localhost:5173

# URL PUBBLICO del backend (senza slash finale) — usato per costruire il
# link incorporato nel QR code e da scrivere sui tag NFC di login.
# In locale va bene il default (http://localhost:PORT); in produzione va
# impostato all'URL reale del backend, es. https://tuo-app.onrender.com
# ATTENZIONE: se lo cambi dopo aver già stampato/programmato dei badge,
# quelli esistenti smettono di funzionare (puntano al vecchio dominio) e
# vanno rigenerati.
PUBLIC_API_URL=http://localhost:5000

# Badge QR/NFC — quante scansioni per IP ogni RATE_LIMIT_WINDOW_MS
RATE_LIMIT_BADGE_MAX=30

# Vision AI — quante scansioni per utente ogni RATE_LIMIT_WINDOW_MS
# (i provider gratuiti hanno una quota giornaliera condivisa da tutti)
RATE_LIMIT_VISION_MAX=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000   # 15 minuti
RATE_LIMIT_MAX=200
RATE_LIMIT_LOGIN_MAX=10

# Email (opzionale — metti ENABLE_EMAIL=false per disabilitare del tutto)
# Provider intercambiabile, stesso principio di AI_VISION_PROVIDER sotto:
# Valori: resend (consigliato) | smtp | mailersend | console (solo log, dev)
ENABLE_EMAIL=false
EMAIL_PROVIDER=resend
MAIL_FROM=noreply@tuodominio.com
MAIL_FROM_NAME=Warehouse Pro
MAIL_ADMIN=tua@email.com

# EMAIL_PROVIDER=resend — https://resend.com/api-keys (gratis: 3000 email/mese)
RESEND_API_KEY=re_xxxxxxxxxxxx

# EMAIL_PROVIDER=smtp — funziona con Brevo, Amazon SES, Google Workspace, ecc.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# EMAIL_PROVIDER=mailersend — provider originale, tenuto per compatibilità
# MAILERSEND_API_KEY=mlsn.xxxx

# Password dimenticata — quante richieste per IP ogni RATE_LIMIT_WINDOW_MS
RATE_LIMIT_FORGOT_MAX=5

# Seed admin iniziale
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Amministratore

# ════════════════════════════════════════════
# IA VISION — sistema provider switchabile
# Cambia AI_VISION_PROVIDER senza toccare altro codice
# Valori: huggingface | gemini | ollama | mock
# ════════════════════════════════════════════
AI_VISION_PROVIDER=huggingface

# Hugging Face (default — gratuito, open source, no tracking commerciale)
# Chiave gratuita: https://huggingface.co/settings/tokens
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_MODEL=microsoft/Florence-2-base    # opzionale

# Google Gemini (1500 req/giorno gratis)
# GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxx

# Ollama locale (MASSIMA PRIVACY — nessun dato esce dalla rete)
# Installa: https://ollama.com  poi esegui: ollama pull llava
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llava

# Cloudinary — upload foto prodotto (metti true per attivarlo)
# Registrazione gratuita su https://cloudinary.com, le 3 chiavi sono
# nella Dashboard subito dopo il login.
ENABLE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
