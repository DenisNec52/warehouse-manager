{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://warehouse-manager-gwuc.onrender.com/api/:path*" },
    { "source": "/__echo/:path*", "destination": "https://httpbin.org/anything/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
